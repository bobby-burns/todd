# Copy to .env and adjust. Everything here is optional — keys can also be added in the dashboard
# (Settings → Models / Integrations), where they're stored encrypted in Postgres.

# --- Infra -------------------------------------------------------------------------------------
POSTGRES_PASSWORD=todd
# Shared secret between api and sandbox. Change it.
SANDBOX_TOKEN=change-me-sandbox-token
# Fernet key for the vault. Leave empty to auto-generate one (stored in the api data volume).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TODD_SECRET_KEY=
# Password for the live browser view (noVNC). Empty = no password (ports are bound to localhost).
VNC_PASSWORD=

# --- Engine -----------------------------------------------------------------------------------
# By default agents run on your Claude plan through Claude Code: sign in once with
#   docker compose exec -it api claude auth login
# The keys below are only used when Settings → Engine is "API keys" (they're never passed to Claude Code,
# so they can't silently switch it to API billing).

# --- Model keys (fallbacks; the dashboard vault takes precedence) ------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Integrations (fallbacks) ------------------------------------------------------------------
VERCEL_TOKEN=
GITHUB_TOKEN=

# --- Limits ------------------------------------------------------------------------------------
TODD_PLANNER_MAX_TURNS=60
TODD_CODE_MAX_STEPS=80
TODD_BROWSER_MAX_STEPS=75
